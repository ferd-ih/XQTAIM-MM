CON 1.0 Y/9 -1.0 Y/18 = 0
CON 1.0 Z/9 -1.0 Z/18 = 0! Atom 9 is C(3), atom 18 is H(5)
CON 1.0 X/10  -1.0 X/19 = 0
CON 1.0 Y/10 -1.0 Y/19 = 0
CON 1.0 Z/10 -1.0 Z/19 = 0! Atom 10 is C(4), atom 19 is H(6)
CON 1.0 X/11  -1.0 X/20 = 0
CON 1.0 Y/11 -1.0 Y/20 = 0
CON 1.0 Z/11 -1.0 Z/20 = 0! Atom 11 is C(5), atom 20 is H(7)
CON 1.0 X/11  -1.0 X/21 = 0
CON 1.0 Y/11 -1.0 Y/21 = 0
CON 1.0 Z/11 -1.0 Z/21 = 0! Atom 11 is C(5), atom 21 is H(8)
