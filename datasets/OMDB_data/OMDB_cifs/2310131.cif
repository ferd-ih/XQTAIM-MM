MODULE *XDLSM
SELECT  *model 4 2 1 0 based_on F^2 test 
SELECT  cycle 20 dampk 1. cmin 0.6 cmax 1. eigcut 1.d-09 convcrit 0.0
SAVE  deriv lsqmat *cormat
SOLVE  *inv diag *cond
!------------------------------------------------------------------------------
